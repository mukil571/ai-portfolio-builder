# Copy to .env.local and fill in. Never commit real values.
# `neon init` / `neon env pull` writes the Neon values for you.

# --- Database (Neon Postgres + pgvector) ---
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# Local development alternative (embedded Postgres file, works offline; never on Vercel).
# Use this INSTEAD of the two lines above, then run `npm run db:migrate` with the dev server stopped:
# DATABASE_URL="pglite:./.local-db"
# Written by the Neon CLI; not read by the app.
NEON_BRANCH=""
NEON_BRANCH_ID=""
NEON_FUNCTION_HOST_SUFFIX=""

# --- Auth (Better Auth) ---
# Required, 32+ chars. Generate: openssl rand -base64 32  (use a different one per environment)
BETTER_AUTH_SECRET=""
# Optional: Google sign-in (button hidden unless both are set).
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (Resend) ---
# Optional locally: without it, emails are printed to the server log and saved in
# .local-outbox/ (e2e tests read them). Required on Vercel.
RESEND_API_KEY=""

# --- Image uploads (Vercel Blob) ---
# Vercel: Storage -> Create -> Blob, connect to the project (adds this automatically).
# Optional: without it, owners paste image links instead of uploading.
BLOB_READ_WRITE_TOKEN=""
EMAIL_FROM="Loriyum <onboarding@resend.dev>"

# --- Owners' own AI keys (Phase 8) ---
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it once keys are saved (they could no longer be decrypted).
API_KEY_ENCRYPTION_KEY=""

# --- Daily question digest (Vercel Cron, see vercel.json) ---
# Any long random string (e.g. openssl rand -base64 32). Vercel sends it to /api/cron/digest.
CRON_SECRET=""

# --- AI (platform keys) ---
# Google AI Studio key for the fixed embedding model (gemini-embedding-001, 768 dims).
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Tooling ---
# Set to 1 to skip env validation (e.g. lint/typecheck in CI without secrets).
# SKIP_ENV_VALIDATION=1
