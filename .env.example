# Copy to .env.local and fill in. Never commit real values.
# `neon init` / `neon env pull` writes the Neon values for you.

# --- Database (Neon Postgres + pgvector) ---
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# Written by the Neon CLI; not read by the app.
NEON_BRANCH=""
NEON_BRANCH_ID=""
NEON_FUNCTION_HOST_SUFFIX=""

# --- Auth (Better Auth) ---
# Required, 32+ chars. Generate: openssl rand -base64 32  (use a different one per environment)
BETTER_AUTH_SECRET=""
# Optional: Google sign-in (button hidden unless both are set).
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (Resend) ---
# Optional in dev: without it, verification/reset links are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Loriyum <onboarding@resend.dev>"

# --- AI (platform keys) ---
# Google AI Studio key for the fixed embedding model (gemini-embedding-001, 768 dims).
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Tooling ---
# Set to 1 to skip env validation (e.g. lint/typecheck in CI without secrets).
# SKIP_ENV_VALIDATION=1
